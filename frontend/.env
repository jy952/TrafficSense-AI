# Public, non-secret backend configuration.
VITE_API_BASE_URL=https://trafficsense-ai-u2t2.onrender.com
# Which endpoints are served by FastAPI. "true" enables all; a list like "predict,roads" enables those only.
# Only /api/predict exists on the backend today, so the other pages keep showing demo data.
VITE_USE_BACKEND=predict
